# ---------------------------------------------------------------------------
# Copia este archivo a .env y rellena los tres primeros valores.
#   cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# 1) Token del bot, te lo da @BotFather en Telegram (/newbot).
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Quién puede usar el bot. Tu id numérico: arranca el bot y escríbele /id.
#    Varios separados por comas. '*' deja entrar a cualquiera (no lo hagas:
#    quien encuentre el bot gastaría tu saldo de la API).
TELEGRAM_ALLOWED_USER_IDS=123456789

# 3) Tu clave de la API de Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# A partir de aquí, todo tiene un valor por defecto razonable.
# ---------------------------------------------------------------------------

# Modelo por defecto: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5 | claude-fable-5
# (se puede cambiar en caliente con /modelo)
CLAUDEGRAM_MODEL=claude-opus-5

# Esfuerzo de razonamiento: low | medium | high | xhigh | max
# medium va bien para chatear; más esfuerzo = mejor, más lento y más caro.
CLAUDEGRAM_EFFORT=medium

# Tope de tokens por respuesta (incluye el razonamiento del modelo).
CLAUDEGRAM_MAX_TOKENS=8000

# Dónde se guardan las conversaciones.
CLAUDEGRAM_STATE_DIR=./state

# Cuánta conversación se manda de vuelta en cada turno.
CLAUDEGRAM_HISTORY_MAX_MESSAGES=60
CLAUDEGRAM_HISTORY_MAX_CHARS=400000

# true = ver la respuesta escribiéndose, editando el mensaje cada pocos
# segundos. Más bonito, pero gasta más datos: en un avión, déjalo en false.
CLAUDEGRAM_STREAM_EDITS=false
CLAUDEGRAM_EDIT_INTERVAL_SECONDS=4

# Segundos que espera cada long poll a Telegram.
CLAUDEGRAM_POLL_TIMEOUT_SECONDS=30

# Si Claude declina una petición, la API la reintenta sola en otro modelo.
CLAUDEGRAM_REFUSAL_FALLBACKS=true

# true = al arrancar, ignora los mensajes que llegaron mientras estaba parado.
CLAUDEGRAM_DROP_PENDING_ON_START=false

# DEBUG para ver cada petición en el log.
CLAUDEGRAM_LOG_LEVEL=INFO

# Instrucciones del sistema. Si lo dejas vacío se usa el prompt por defecto,
# que ya le pide respuestas cortas y pensadas para leerse en el móvil.
# CLAUDEGRAM_SYSTEM_PROMPT=
